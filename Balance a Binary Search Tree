Balance a Binary Search Tree
--------------------------------------------------------------------------------
Time Complexity: O(n) 
Space Complexity: O(n)
--------------------------------------------------------------------------------
class Solution {
    public TreeNode balanceBST(TreeNode root) {
        List<TreeNode> nodes = new ArrayList<>();
        
        // Step 1: Store nodes in sorted order
        inorder(root, nodes);
        
        // Step 2: Build balanced BST
        return buildBalanced(nodes, 0, nodes.size() - 1);
    }
    
    private void inorder(TreeNode root, List<TreeNode> nodes) {
        if (root == null) return;
        inorder(root.left, nodes);
        nodes.add(root);
        inorder(root.right, nodes);
    }
    
    private TreeNode buildBalanced(List<TreeNode> nodes, int left, int right) {
        if (left > right) return null;
        
        int mid = left + (right - left) / 2;
        TreeNode root = nodes.get(mid);
        
        root.left = buildBalanced(nodes, left, mid - 1);
        root.right = buildBalanced(nodes, mid + 1, right);
        
        return root;
